fn (f,x) { (fn(f, x) { let y = f(f(x)); (f, x) })(f,x) }
> fn (f, x) { (fn (f, x) { let y = f(f(x)); (f, x) })(f, x) }
>   fn [a, b, c <: (a | b) -> a](f: c, x: b) -> (c, b) {
>     (fn [a_2, b_2, c_2 <: (a_2 | b_2) -> a_2](f: c_2, x: b_2) -> (c_2, b_2) {
>       let y : a_2 = f(f(x));
>       (f, x)
>     })(f, x)
>   }
> [a, b, c <: (a | b) -> a] (c, b) -> (c, b)
> let  = %yield(fun (f, x) ret {
>   let x2 = fun (f2, x2) ret2 {
>     let x3 = f2(x2);
>     let x4 = f2(x3);
>     ret2((0: f2, 1: x2))
>   }(f, x);
>   ret(x2)
> });
> done

fn[p,q,r](f : (p|q|r) -> p, x : q) -> ((r -> (p|r)), q) { (f, x) }
> fn [p, q, r](f: (p | q | r) -> p, x: q) -> (r -> p | r, q) { (f, x) }
>   fn [p, q, r](f: (p | q | r) -> p, x: q) -> (r -> p | r, q) { (f, x) }
> [p, q, r] ((p | q | r) -> p, q) -> (r -> p | r, q)
> let  = %yield(fun (f, x) ret { ret((0: f, 1: x)) }); done

fn (f,x) { (fn(f, x) { let y = f(f(x)); (fn(p){f(p)}, x) })(f,x) }
> fn (f, x) { (fn (f, x) { let y = f(f(x)); (fn (p) { f(p) }, x) })(f, x) }
>   fn [a, b, c](f: (a | b | c) -> b, x: c) -> (a -> b, c) {
>     (fn [a_2, b_2, c_2](f: (a_2 | b_2 | c_2) -> b_2, x: c_2) ->
>       (a_2 -> b_2, c_2) {
>       let y : b_2 = f(f(x));
>       (fn (p: a_2) -> b_2 { f(p) }, x)
>     })(f, x)
>   }
> [a, b, c] ((a | b | c) -> b, c) -> (a -> b, c)
> let  = %yield(fun (f, x) ret {
>   let x2 = fun (f2, x2) ret2 {
>     let x3 = f2(x2);
>     let x4 = f2(x3);
>     ret2((0: fun (p) ret3 { let x5 = f2(p); ret3(x5) }, 1: x2))
>   }(f, x);
>   ret(x2)
> });
> done

# partial poly
