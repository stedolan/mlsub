# real rank1 type (check forall not hoisted)
fn (a) { (fn(x) { (x, fn(x) { x }) })(a) }
> fn (a) { (fn (x) { (x, fn (x) { x }) })(a) }
>   fn [a](a: a) -> (a, [a_2] a_2 -> a_2) {
>     (fn [a_2](x: a_2) -> (a_2, [a_3] a_3 -> a_3) {
>       (x, fn [a_3](x: a_3) -> a_3 { x })
>     })(a)
>   }
> [a] a -> (a, [a_2] a_2 -> a_2)
> let  = %yield(fun (a) ret {
>   let x = fun (x) ret2 {
>     ret2((0: x, 1: fun (x2) ret3 { ret3(x2) }))
>   }(a);
>   ret(x)
> });
> done

