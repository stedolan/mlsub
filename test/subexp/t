# poly!
fn[a](x : a) { x }
> fn [a](x: a) { x }
>   fn [a](x: a) -> a { x }
> [a] a -> a
> let  = %yield(fun (x) ret { ret(x) }); done

fn[a,b](id : [a](a) -> a, (x,y):(a, b)) { (id(y),id(x)) }
> fn [a, b](id: [a] a -> a, (x, y): (a, b)) { (id(y), id(x)) }
>   fn [a, b](id: [a_2] a_2 -> a_2, (x, y): (a, b)) -> (b, a) { (id(y), id(x)) }
> [a, b] ([a_2] a_2 -> a_2, (a, b)) -> (b, a)
> let  = %yield(fun (id, param) ret {
>   let v0, v1 = param.(0, 1);
>   let x = id(v0);
>   let x2 = id(v1);
>   ret((0: x2, 1: x))
> });
> done

fn(id : [a](a) -> a, (x,y)) { (id(y),id(x)) }
> fn (id: [a] a -> a, (x, y)) { (id(y), id(x)) }
>   fn [a, b](id: [a_2] a_2 -> a_2, (x, y): (a, b)) -> (b, a) { (id(y), id(x)) }
> [a, b] ([a_2] a_2 -> a_2, (a, b)) -> (b, a)
> let  = %yield(fun (id, param) ret {
>   let v0, v1 = param.(0, 1);
>   let x = id(v0);
>   let x2 = id(v1);
>   ret((0: x2, 1: x))
> });
> done

fn[a](x : a) { if x.cond {x} else {x} }
> fn [a](x: a) { if x.cond { x } else { x } }
> test:1: Type error
>   fn[a](x : a) { if x.cond {x} else {x} }
>                     ^^^^^^
>      found: a
>   expected: {cond: _, ...}
> This a comes from test:1:
>   fn[a](x : a) { if x.cond {x} else {x} }
>             ^
> but is used as {cond: _, ...}

fn[a <: {cond:Bool}](x : a) { if x.cond {x} else {x} }
> fn [a <: {cond: Bool}](x: a) { if x.cond { x } else { x } }
>   fn [a <: {cond: Bool}](x: a) -> a { if x.cond { x } else { x } }
> [a <: {cond: Bool}] a -> a
> let  = %yield(fun (x) ret {
>   let cond = x.(cond);
>   match cond {
>     true() -> {
>       ret(x)
>     };
>     false() -> {
>       ret(x)
>     }
>   }
> });
> done

fn(f) { fn[a](x : a) { f(x) } }
