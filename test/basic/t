# ({foo: @true}.foo : Bool)
# > ({foo: @true}.foo : Bool)
# > Bool
# # update: no longer think this is cool

# Generalisation of functions allows checking against inferred argument types
(fn(x) { if x.cond { 1 } else { 2 }})(#{cond: @true})
> (fn (x) { if x.cond { 1 } else { 2 } })(#{cond: @true})
>   (fn (x: {cond: Bool}) -> Int { if x.cond { 1 } else { 2 } })(#{cond: @true})
> Int
> let x = fun (x) ret {
>   match x.cond {
>     true -> {
>       ret(1)
>     };
>     false -> {
>       ret(2)
>     }
>   }
> }((cond: <true>));
> let  = %yield(x);
> done

(fn(g) { if g () {1} else {2}})(fn() { @true })
> (fn (g) { if g() { 1 } else { 2 } })(fn () { @true })
>   (fn (g: () -> Bool) -> Int { if g() { 1 } else { 2 } })(fn () { @true })
> Int
> let x = fun (g) ret {
>   let x = g();
>   match x {
>     true -> {
>       ret(1)
>     };
>     false -> {
>       ret(2)
>     }
>   }
> }(fun () ret { ret(<true>) });
> let  = %yield(x);
> done

