# variants
{
type Option[a]{
| None
| Some(a)
}
type Z[x] {
  foo: Option.Some[x]
  bar: Option[Int]
}
fn f(x) {
  match x {
  | Z{foo: Some(a), bar:Some(b)} => (a(3),b)
  | Z{foo: Some(a), bar:Option.None} => (a(7),1)
  }
}
fn g() { (f({foo: Some(fn(x){x}), bar:None}), Option.Some(true)) }
}
> type Option[+a]{ None | Some(a) }
> type Z[+x]{foo: Option.Some[x], bar: Option[Int]}
> fn f[a](x: Z[Int -> a]) -> (a, Int) {
>   match x {
>     | Z{foo: Some(a), bar: Some(b)} => (a(3), b)
>     | Z{foo: Some(a), bar: Option.None} => (a(7), 1)
>   }
> }
> fn g() -> ((Int, Int), Option.Some[Bool]) {
>   (f(Z{foo: Option.Some(fn (x) { x }), bar: Option.None}), Option.Some(true))
> }

